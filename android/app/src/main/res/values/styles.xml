    <style name="AppTheme.Green.Toolbar" parent="AppTheme.Green">
        <item name="android:textColorSecondary">#fff</item>
        <item name="actionButtonStyle">@style/AppTheme.Toolbar.ActionButton</item>
    </style>

    <!-- Yellow theme -->
    <style name="AppTheme.Yellow" parent="AppTheme">
        <item name="colorPrimary">@color/primary_yellow</item>
        <item name="colorPrimaryDark">@color/primary_dark_yellow</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="pyluxAccent">@color/accent_yellow</item>
        <item name="pyluxAccentLight">@color/accent_light_yellow</item>
        <item name="pyluxAccentA12">@color/accent_yellow_a12</item>
        <item name="pyluxAccentA20">@color/accent_yellow_a20</item>
        <item name="pyluxAccentA25">@color/accent_yellow_a25</item>
        <item name="pyluxAccentA30">@color/accent_yellow_a30</item>
        <item name="pyluxAccentA50">@color/accent_yellow_a50</item>
        <item name="pyluxAccentA70">@color/accent_yellow_a70</item>
        <item name="pyluxAccentA80">@color/accent_yellow_a80</item>
        <item name="pyluxToolbarBg">@color/toolbar_bg_yellow</item>
        <item name="pyluxToolbarTheme">@style/AppTheme.Yellow.Toolbar</item>
        <item name="pyluxSupportTierCardBg">@color/support_tier_card_bg_yellow</item>
        <item name="pyluxSupportTextSecondary">@color/support_text_secondary_yellow</item>
        <item name="pyluxSupportBadgeBg">@color/support_badge_bg_yellow</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog.Yellow</item>
    </style>
    <style name="AppTheme.Yellow.Toolbar" parent="AppTheme.Yellow">
        <item name="android:textColorSecondary">#fff</item>
        <item name="actionButtonStyle">@style/AppTheme.Toolbar.ActionButton</item>
    </style>

    <!-- Orange theme -->
    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorPrimaryDark">@color/primary_dark_orange</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="pyluxAccent">@color/accent_orange</item>
        <item name="pyluxAccentLight">@color/accent_light_orange</item>
        <item name="pyluxAccentA12">@color/accent_orange_a12</item>
        <item name="pyluxAccentA20">@color/accent_orange_a20</item>
        <item name="pyluxAccentA25">@color/accent_orange_a25</item>
        <item name="pyluxAccentA30">@color/accent_orange_a30</item>
        <item name="pyluxAccentA50">@color/accent_orange_a50</item>
        <item name="pyluxAccentA70">@color/accent_orange_a70</item>
