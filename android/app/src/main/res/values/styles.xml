        <item name="colorPrimaryDark">@color/primary_dark_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="pyluxAccent">@color/accent_green</item>
        <item name="pyluxAccentLight">@color/accent_light_green</item>
        <item name="pyluxAccentA12">@color/accent_green_a12</item>
        <item name="pyluxAccentA20">@color/accent_green_a20</item>
        <item name="pyluxAccentA25">@color/accent_green_a25</item>
        <item name="pyluxAccentA30">@color/accent_green_a30</item>
        <item name="pyluxAccentA50">@color/accent_green_a50</item>
        <item name="pyluxAccentA70">@color/accent_green_a70</item>
        <item name="pyluxAccentA80">@color/accent_green_a80</item>
        <item name="pyluxToolbarBg">@color/toolbar_bg_green</item>
