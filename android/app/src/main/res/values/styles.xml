    </style>

    <style name="AppTheme.Toolbar.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="AppTheme.FloatingActionButtonSpeedDial">
        <item name="tint">@color/floating_action_button_speed_dial_tint</item>
        <item name="android:backgroundTint">?attr/pyluxAccent</item>
        <item name="android:textColor">@color/floating_action_button_speed_dial_tint</item>
    </style>

    <style name="AppTheme.AlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
        <item name="materialButtonStyle">@style/AppTheme.AlertDialog.Button</item>
        <item name="android:windowBackground">@drawable/bg_disclaimer_box</item>
    </style>

    <!-- androidx.preference's ListPreferenceDialogFragmentCompat/EditTextPreferenceDialogFragmentCompat
         (Locale, Image Processing, Resolution, FPS, Bitrate, Codec, Datacenter, Theme Colour —
         every "pop up box" preference in Settings) build via plain AlertDialog.Builder(context),
         which resolves through this attr rather than materialAlertDialogTheme above — confirmed
         against the androidx.preference 1.2.0 sources. Without windowBackground here they fell
         back to Theme.AppCompat.Dialog.Alert's own default (a plain light dialog), the one gap
         AppAlertDialogBuilder's programmatic override never reached since these dialogs are never
         built through it. -->
    <style name="AppTheme.AlertDialog.NonMaterial" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="materialButtonStyle">@style/AppTheme.AlertDialog.Button</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
        <item name="android:windowBackground">@drawable/bg_disclaimer_box</item>
        <!-- select_dialog_singlechoice_material (every ListPreference row — Locale, Resolution,
             FPS, Codec, Datacenter, Theme Colour, etc.) reads its row background from this attr.
             Overridden so the currently-highlighted row (touch, D-pad focus, or the entry already
             selected when the dialog opens) uses the same translucent theme-accent highlight as
             every other dropdown in the app, instead of the platform's stock grey ripple. -->
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_dropdown_item_highlight</item>
    </style>

    <style name="AppTheme.AlertDialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/pyluxAccent</item>
    </style>

    <style name="AppTheme.AlertDialog.Blue" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
    </style>

    <style name="AppTheme.AlertDialog.Green" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
    </style>

    <style name="AppTheme.AlertDialog.Yellow" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
    </style>

    <style name="AppTheme.AlertDialog.Orange" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorControlActivated">?attr/pyluxAccent</item>
    </style>

    <!-- Shared look for every PopupMenu in the app — see popupMenuStyle on AppTheme. -->
    <style name="AppPopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <!-- Scopes the white item-text override to just this popup's own inflated views,
             rather than touching android:textColorPrimary on AppTheme itself, which is read by
             far too many other unrelated widgets app-wide to safely override globally.
             AppCompat's own abc_popup_menu_item_layout.xml (confirmed by extracting the library)
             renders item text via ?attr/textAppearanceLargePopupMenu, which under both
             AppTheme's and StreamTheme's MaterialComponents bases ultimately resolves color from
             android:textColorPrimary — so this alone is sufficient once the PopupMenu instance
             is actually androidx.appcompat.widget.PopupMenu (see popupMenuStyle's comment on
             AppTheme for why that class distinction is what previous attempts missed). -->
        <item name="android:theme">@style/ThemeOverlay.App.PopupMenu</item>
    </style>

    <style name="ThemeOverlay.App.PopupMenu" parent="ThemeOverlay.AppCompat">
        <item name="android:textColorPrimary">@android:color/white</item>
    </style>

    <style name="MageTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorPrimarySurface">@color/primary</item>
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">?attr/colorPrimarySurface</item>
        <item name="android:navigationBarColor">?attr/colorPrimarySurface</item>
        <item name="colorControlNormal">@color/accent</item>
        <item name="colorButtonNormal">@color/accent</item>
        <item name="android:textAppearanceButton">@style/MageTheme.TextAppearanceButton</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>

        <item name="textAppearanceHeadline1">@style/MageTheme.TextAppearanceHeadline1</item>

        <item name="android:colorControlActivated">?attr/colorAccent</item>
        <item name="android:colorControlHighlight">?attr/colorAccent</item>

        <item name="textInputStyle">@style/MageTheme.TextInputStyle</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
    </style>

    <style name="MageTheme.Translucent" parent="MageTheme">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="MageTheme.TextAppearanceHeadline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">sans-serif-condensed-light</item>
    </style>

    <style name="MageTheme.TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="hintTextColor">?attr/colorAccent</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxStrokeColor">@color/mage_text_input_box_stroke</item>
        <item name="boxBackgroundColor">?attr/colorPrimaryDark</item>
    </style>

    <style name="MageTheme.TextInputStyle.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="hintTextColor">?attr/colorAccent</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxStrokeColor">@color/mage_text_input_box_stroke</item>
        <item name="boxBackgroundColor">?attr/colorPrimaryDark</item>
    </style>

    <style name="MageTheme.Button" parent="Widget.MaterialComponents.Button">
        <item name="tint">?attr/colorOnSecondary</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="iconTint">?attr/colorOnSecondary</item>
    </style>

    <!-- Secondary action button: grey fill, white text, theme-accent border -->
    <style name="MageTheme.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="tint">@android:color/white</item>
        <item name="android:backgroundTint">@color/disclaimer_box_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="strokeColor">?attr/colorAccent</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">?attr/colorAccent</item>
    </style>

    <style name="MageTheme.TextAppearanceButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="StreamTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
        <!-- Covers dialogs built as a raw AlertDialog rather than through MaterialAlertDialogBuilder
             (e.g. ControllerRemapCapture's "press a button" prompt, which subclasses AlertDialog
             directly to override dispatchKeyEvent/dispatchGenericMotionEvent for capture) — those
             resolve their theme via this attribute, not materialAlertDialogTheme above. Without it,
             they fell back to this theme's Theme.MaterialComponents.Light parent's own light-themed
             default, rendering black text on the dark dialog background. Matches AppTheme's own
             identical override — StreamActivity only stays on this manifest theme for the default
             pink colour (see the pyluxAccent* comment below); every other theme colour switches to
             an AppTheme.<colour> subtheme via setTheme(), which already inherits this from AppTheme. -->
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog.NonMaterial</item>
        <!-- StreamTheme's parent (Theme.MaterialComponents.Light.NoActionBar) is a *separate*
             hierarchy from AppTheme, so it doesn't inherit AppTheme's popupMenuStyle override
             below — without these, every in-stream PopupMenu (Quick Settings' trophy sort/filter
             dropdowns, etc.) fell back to the unstyled default instead of matching the app's
             themed popups everywhere else. popupMenuStyle (not android:popupMenuStyle) is what
             actually governs androidx.appcompat.widget.PopupMenu, the class those call sites use
             — see the matching comment on AppTheme. -->
        <item name="popupMenuStyle">@style/AppPopupMenuStyle</item>
        <item name="actionOverflowMenuStyle">@style/AppPopupMenuStyle</item>
        <item name="android:windowBackground">@color/stream_background</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- StreamActivity only calls setTheme() to AppTheme.<colour> for non-pink themes
             (see StreamActivity.onCreate) — this manifest-declared theme stays active for
             the default pink colour, so it needs its own pyluxAccent* attrs matching AppTheme's
             (all of them, not just pyluxAccent — a missing one crashes inflation outright with
             an unresolved ?attr reference, rather than just rendering wrong). -->
        <item name="pyluxAccent">@color/accent</item>
        <item name="pyluxAccentLight">@color/accent_light</item>
        <item name="pyluxAccentA12">@color/accent_pink_a12</item>
        <item name="pyluxAccentA20">@color/accent_pink_a20</item>
        <item name="pyluxAccentA25">@color/accent_pink_a25</item>
        <item name="pyluxAccentA30">@color/accent_pink_a30</item>
        <item name="pyluxAccentA50">@color/accent_pink_a50</item>
        <item name="pyluxAccentA70">@color/accent_pink_a70</item>
        <item name="pyluxAccentA80">@color/accent_pink_a80</item>
        <!-- See the matching item on AppTheme (used for every non-pink colour, which
             setTheme()s to AppTheme.<colour> instead — see the class-level comment above) — this
             manifest-declared theme stays active only for the default pink colour, so it needs
             its own copy for that case's Quick Settings Spinner dropdowns to get the same
             highlight instead of the platform default grey. -->
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_dropdown_item_highlight</item>
    </style>

    <!-- Non-pink StreamActivity theme colours. StreamActivity used to setTheme() straight to
         AppTheme.<colour> for these, but AppTheme never sets windowTranslucentStatus/
         windowTranslucentNavigation (only StreamTheme does) — those flags are what let the
         stream screen's window extend behind the system nav bar, so switching to a non-pink
         theme was leaving a nav-bar-sized gap at the bottom that only the Pink/StreamTheme path
         didn't have. These extend StreamTheme itself (for those flags and windowBackground)
         and just swap in each colour's accent attrs, mirroring AppTheme.<colour>. -->
    <style name="StreamTheme.Blue" parent="StreamTheme">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_dark_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog.Blue</item>
        <item name="pyluxAccent">@color/accent_blue</item>
        <item name="pyluxAccentLight">@color/accent_light_blue</item>
        <item name="pyluxAccentA12">@color/accent_blue_a12</item>
        <item name="pyluxAccentA20">@color/accent_blue_a20</item>
        <item name="pyluxAccentA25">@color/accent_blue_a25</item>
        <item name="pyluxAccentA30">@color/accent_blue_a30</item>
        <item name="pyluxAccentA50">@color/accent_blue_a50</item>
        <item name="pyluxAccentA70">@color/accent_blue_a70</item>
        <item name="pyluxAccentA80">@color/accent_blue_a80</item>
    </style>

    <style name="StreamTheme.Green" parent="StreamTheme">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_dark_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog.Green</item>
        <item name="pyluxAccent">@color/accent_green</item>
        <item name="pyluxAccentLight">@color/accent_light_green</item>
