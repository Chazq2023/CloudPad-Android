<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">?attr/colorPrimarySurface</item>
        <item name="android:navigationBarColor">?attr/colorPrimarySurface</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog.NonMaterial</item>
        <item name="android:windowActivityTransitions">true</item>
        <!-- Every PopupMenu in the app (sort/filter menus, the account menu, etc.) is built as
             `androidx.appcompat.widget.PopupMenu(context, anchor)`, which resolves its appearance
             from this AppCompat-declared attribute (not the platform's identically-named
             android:popupMenuStyle — that one only governs the platform's own
             android.widget.PopupMenu, a different class, and setting only that one left item text
             black: confirmed by extracting AppCompat's own popup item layout, which resolves
             color through this attribute's style chain instead). Styling it here covers every
             call site at once. See AppPopupMenuStyle below. -->
        <item name="popupMenuStyle">@style/AppPopupMenuStyle</item>
        <!-- A Toolbar's own "⋮" overflow menu (e.g. Controller Remap's "Restore to defaults")
             resolves through this attribute instead of popupMenuStyle above — confirmed by it
             still showing the platform default even with popupMenuStyle already set. Same shared
             style either way. -->
        <item name="actionOverflowMenuStyle">@style/AppPopupMenuStyle</item>
        <!-- Pylux brand colour attrs — Neon Pink default -->
        <item name="pyluxAccent">@color/accent</item>
        <item name="pyluxAccentLight">@color/accent_light</item>
        <item name="pyluxAccentA12">@color/accent_pink_a12</item>
        <item name="pyluxAccentA20">@color/accent_pink_a20</item>
        <item name="pyluxAccentA25">@color/accent_pink_a25</item>
        <item name="pyluxAccentA30">@color/accent_pink_a30</item>
        <item name="pyluxAccentA50">@color/accent_pink_a50</item>
        <item name="pyluxAccentA70">@color/accent_pink_a70</item>
        <item name="pyluxAccentA80">@color/accent_pink_a80</item>
        <item name="pyluxToolbarBg">@color/toolbar_bg</item>
        <item name="pyluxToolbarTheme">@style/AppTheme.Toolbar</item>
        <item name="pyluxSupportTierCardBg">@color/support_tier_card_bg</item>
        <item name="pyluxSupportTextSecondary">@color/support_text_secondary</item>
        <item name="pyluxSupportBadgeBg">@color/support_badge_bg</item>
        <!-- Governs BOTH AlertDialog single-choice rows (also set on AppTheme.AlertDialog.NonMaterial,
             needed there separately since that's a nested theme AlertDialog resolves independently
             of this one) AND, critically, every plain Spinner's dropdown list — confirmed on-device
             that Spinner's popup reads this straight from whichever theme is active on the hosting
             Activity, not from the AlertDialog-specific style, so it needs setting here too or any
             Spinner (Quick Settings' Overlay Type/Resolution/etc.) falls back to the platform's
             default grey row highlight regardless of what dropdown_menu_popup_item.xml's own row
             background is set to. -->
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_dropdown_item_highlight</item>
    </style>

    <!-- Neon Blue variant — all activity/fragment themes that extend AppTheme pick this up -->
    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_dark_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="pyluxAccent">@color/accent_blue</item>
        <item name="pyluxAccentLight">@color/accent_light_blue</item>
        <item name="pyluxAccentA12">@color/accent_blue_a12</item>
        <item name="pyluxAccentA20">@color/accent_blue_a20</item>
        <item name="pyluxAccentA25">@color/accent_blue_a25</item>
        <item name="pyluxAccentA30">@color/accent_blue_a30</item>
        <item name="pyluxAccentA50">@color/accent_blue_a50</item>
        <item name="pyluxAccentA70">@color/accent_blue_a70</item>
        <item name="pyluxAccentA80">@color/accent_blue_a80</item>
        <item name="pyluxToolbarBg">@color/toolbar_bg_blue</item>
        <item name="pyluxToolbarTheme">@style/AppTheme.Blue.Toolbar</item>
        <item name="pyluxSupportTierCardBg">@color/support_tier_card_bg_blue</item>
        <item name="pyluxSupportTextSecondary">@color/support_text_secondary_blue</item>
        <item name="pyluxSupportBadgeBg">@color/support_badge_bg_blue</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog.Blue</item>
    </style>

    <style name="AppTheme.Toolbar" parent="AppTheme">
        <item name="android:textColorSecondary">#fff</item>
        <item name="actionButtonStyle">@style/AppTheme.Toolbar.ActionButton</item>
    </style>

    <!-- Blue variant — keeps all pylux attrs from AppTheme.Blue, adds toolbar overrides -->
    <style name="AppTheme.Blue.Toolbar" parent="AppTheme.Blue">
        <item name="android:textColorSecondary">#fff</item>
        <item name="actionButtonStyle">@style/AppTheme.Toolbar.ActionButton</item>
    </style>

    <!-- Neon Green theme -->
