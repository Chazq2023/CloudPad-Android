<?xml version="1.0" encoding="utf-8"?>
<!-- Solid black fill with a theme-accent border — this overlay sits over a paused stream
     frame, which can be any colour, so a translucent fill wasn't enough to stay legible/
     on-theme regardless of what's behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@android:color/black" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/pyluxAccent" />
</shape>
