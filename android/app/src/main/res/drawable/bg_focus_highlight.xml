<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad/controller focus ring for toolbar back buttons — theme-coloured, only visible while
     android:state_focused so touch users never see it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pyluxAccentA20"/>
            <corners android:radius="8dp"/>
            <stroke android:width="2dp" android:color="?attr/pyluxAccent"/>
        </shape>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
