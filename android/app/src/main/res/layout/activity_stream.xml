<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainStreamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.metallic.chiaki.stream.StreamActivity"
    android:keepScreenOn="true">

    <com.metallic.chiaki.stream.AspectRatioFrameLayout
        android:id="@+id/aspectRatioLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.metallic.chiaki.stream.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <!-- Shown for the duration of a Quick Settings Refresh: from the moment it's pressed
         (this Activity, about to finish) through to the replacement StreamActivity reaching
         StreamStateConnected (see StreamActivity.EXTRA_IS_REFRESH / isRefreshLaunch) — a plain
         spinner alone doesn't explain why the stream just went black for a while. -->
    <LinearLayout
        android:id="@+id/refreshOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/refreshOverlaySpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="?attr/pyluxAccent"/>

        <!-- Rounded theme-coloured pill, matching the selected-tab treatment on the main
             library screen (see cloud_tab_selected.xml / the PS5 Library tab) — plain white
             text directly over the stream's paused frame can be hard to read depending on
             what's on screen at the time. -->
        <TextView
            android:id="@+id/refreshOverlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="260dp"
            android:background="@drawable/cloud_tab_selected"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:text="@string/quick_settings_refresh_in_progress_message"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

    </LinearLayout>

    <com.metallic.chiaki.stream.PerformanceOverlayView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:visibility="gone"/>        

    <fragment
        android:id="@+id/controlsFragment"
        android:name="com.metallic.chiaki.touchcontrols.DefaultTouchControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <fragment
        android:id="@+id/touchpadOnlyFragment"
        android:name="com.metallic.chiaki.touchcontrols.TouchpadOnlyFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Quick Settings is its own Dialog window now (see QuickSettingsPanel.kt), not an
         in-window View — sharing a window with the continuously-updating video SurfaceView
         proved unreliable to animate/composite correctly even with visibility and hardware-
         layer workarounds. A separate window is composited above the activity deterministically. -->

</FrameLayout>