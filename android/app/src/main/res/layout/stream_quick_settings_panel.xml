<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stream_panel_background"
    android:clickable="true"
    android:focusable="true"
    android:elevation="8dp">

    <!-- Far-left edge bar, spanning the full height of the panel (unlike quickSettingsTabDivider
         below, which only spans the tab rail's own height) — a themed edge to the whole panel,
         matching the divider treatment already used between the tab rail and its content. -->
    <View
        android:id="@+id/quickSettingsLeftEdgeBar"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="?attr/pyluxAccent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Fixed header: stays pinned regardless of scroll position -->
    <TextView
        android:id="@+id/quickSettingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/quick_settings_title"
        android:textColor="?attr/pyluxAccent"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/quickSettingsCloseButton"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/quickSettingsCloseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/quick_settings_close"
        android:src="@drawable/ic_close"
        android:tint="?attr/pyluxAccent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "Current game" row: cover art + name, shown only for cloud sessions (PS3/PS4/PS5
         streaming) — hidden entirely for Remote Play, which has no catalog game to show. Left
         margin matches quickSettingsTabToggle's below so the icon lines up with the tab rail.
         Collapses to zero height when GONE, so quickSettingsHeaderDivider sits right below the
         title with no gap when this row isn't shown. -->
    <LinearLayout
        android:id="@+id/quickSettingsGameInfoRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/quickSettingsGameIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/quickSettingsGameNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Theme-coloured, edge-to-edge — meets quickSettingsLeftEdgeBar on the left and spans
         all the way to the panel's right edge, sitting directly above the tab rail. -->
    <View
        android:id="@+id/quickSettingsHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?attr/pyluxAccent"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsGameInfoRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom-left disconnect (power) button. Always tinted with the app's theme colour —
         unlike the tab rail below, it isn't a toggle with a selected/unselected state, so it
         uses ?attr/pyluxAccent directly rather than the checked-state colour selector. -->

    <!-- Left-hand tab rail: General Settings / Controller Mapping / (dynamic) Session Settings -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickSettingsDisconnectButton"
        style="@style/QuickSettingsTabButton"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/stream_disconnect_button"
        app:icon="@drawable/ic_power"
        app:iconTint="?attr/pyluxAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/quickSettingsTabToggle"
        app:layout_constraintEnd_toEndOf="@id/quickSettingsTabToggle"
        app:strokeColor="?attr/pyluxAccent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/quickSettingsTabToggle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/quickSettingsTabGeneral"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/quickSettingsTabDivider"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toTopOf="@id/quickSettingsDisconnectButton">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsTabGeneral"
            style="@style/QuickSettingsTabButton"
            android:contentDescription="@string/quick_settings_title"
            app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsTabController"
            style="@style/QuickSettingsTabButton"
            android:contentDescription="@string/controller_remap_preference_title"
            app:icon="@drawable/ic_gamepad" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsTabSession"
            style="@style/QuickSettingsTabButton"
            android:contentDescription="@string/quick_settings_session_tab_description"
            app:icon="@drawable/ic_resolution" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsTabTrophies"
            style="@style/QuickSettingsTabButton"
            android:contentDescription="@string/quick_settings_trophies_tab_description"
            app:icon="@drawable/ic_trophy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsTabFriends"
            style="@style/QuickSettingsTabButton"
            android:contentDescription="@string/quick_settings_friends_tab_description"
            app:icon="@drawable/ic_smiley" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Separates the tab rail from the settings content to its right. Meets
         quickSettingsHeaderDivider at the top and spans all the way to the bottom of the
         panel, matching quickSettingsLeftEdgeBar's full-height treatment on the other side. -->
    <View
        android:id="@+id/quickSettingsTabDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="?attr/pyluxAccent"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="64dp" />

    <!-- Controller tab: remap list. Given a bounded height with its own internal scrolling
         (matching the full-screen Settings > Remap Controller screen) rather than wrap_content
         inside a ScrollView — a RecyclerView measured wrap_content while GONE (as this is
         initially, since General is the default tab) does not reliably size itself to fit
         every item once switched to VISIBLE, silently clipping the list. -->
    <LinearLayout
        android:id="@+id/quickSettingsControllerSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/QuickSettingsSectionLabel"
            android:text="@string/controller_remap_preference_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quickSettingsRemapRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- General tab: everything else -->
    <ScrollView
        android:id="@+id/quickSettingsGeneralScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsStatsRow" />
            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsOscRow" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/quickSettingsOscCustomiseButton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				android:layout_marginBottom="8dp"
				android:text="@string/touch_controls_customise"
				android:textColor="@android:color/white"
				android:visibility="gone"
				app:backgroundTint="?attr/pyluxAccent" />

            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsTouchpadRow" />

            <TextView
                style="@style/QuickSettingsSectionLabel"
                android:text="@string/quick_settings_window_size" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/quickSettingsDisplayModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/quickSettingsDisplayModeNormal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/quickSettingsDisplayModeNormal"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_display_normal"
                    app:iconTint="@color/quick_settings_display_mode_tint"
                    app:strokeColor="@color/quick_settings_display_mode_tint"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/quickSettingsDisplayModeZoom"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_display_zoom"
                    app:iconTint="@color/quick_settings_display_mode_tint"
                    app:strokeColor="@color/quick_settings_display_mode_tint"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/quickSettingsDisplayModeStretch"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_display_stretch"
                    app:iconTint="@color/quick_settings_display_mode_tint"
                    app:strokeColor="@color/quick_settings_display_mode_tint"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsMicrophoneRow" />
            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsMotionRow" />
            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsHapticsRow" />
            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsPipRow" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/QuickSettingsSectionLabel"
                android:text="@string/preferences_category_title_cas_sharpening" />

            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsCasRow" />
            <include layout="@layout/item_quick_settings_seekbar" android:id="@+id/quickSettingsCasSeekBarRow" />

            <TextView
                style="@style/QuickSettingsSectionLabel"
                android:text="@string/preferences_category_title_fsr" />

            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsFsrRow" />
            <include layout="@layout/item_quick_settings_switch" android:id="@+id/quickSettingsFsrUpscalingRow" />
            <include layout="@layout/item_quick_settings_seekbar" android:id="@+id/quickSettingsFsrSharpeningRow" />

        </LinearLayout>

    </ScrollView>

    <!-- Session tab: content depends on whether this is a Remote Play, Game Catalog (PS3/PS4)
         or Game Library (PS5) session — rows are inflated at runtime by QuickSettingsPanel
         since the widget set genuinely differs per session type, not just its labels.
         quickSettingsSessionApplyBar is a sibling (not a child) of the ScrollView so it stays
         pinned below it regardless of scroll position — the ScrollView's own bottom constraint
         targets the bar's top, so it collapses back down to fill the tab whenever the bar is
         GONE (no pending changes). -->
    <ScrollView
        android:id="@+id/quickSettingsSessionScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toTopOf="@id/quickSettingsSessionApplyBar"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quickSettingsSessionRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Static, unlike the rows above it (which QuickSettingsPanel inflates at
                 runtime) — always sits below whatever rows got added, since it's a sibling
                 after quickSettingsSessionRows rather than a child of it. -->
            <TextView
                android:id="@+id/quickSettingsSessionRestartNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center"
                android:text="@string/quick_settings_session_restart_notice"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Pinned Apply bar: hidden (GONE) until a row's value differs from the settings the live
         stream actually last (re)started with — see QuickSettingsPanel.updateSessionApplyVisibility.
         While a restart is in flight the button itself is swapped out for the status text, which
         doubles as the Cloud Play allocation flow's live progress display. -->
    <LinearLayout
        android:id="@+id/quickSettingsSessionApplyBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/quickSettingsSessionApplyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSettingsSessionApplyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_settings_session_apply"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/pyluxAccent" />

    </LinearLayout>

    <!-- Trophies tab: live trophy list for whichever game this session is streaming, resolved
         by name/platform match the same way TrophiesActivity does (see QuickSettingsPanel).
         Lazily fetched the first time this tab is opened; the refresh button re-fetches on
         demand so a trophy unlocked mid-session shows up without leaving/reopening the panel. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quickSettingsTrophiesSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/quickSettingsTrophiesLabel"
            style="@style/QuickSettingsSectionLabel"
            android:layout_width="0dp"
            android:text="@string/quick_settings_trophies_header_label"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/quickSettingsTrophiesRefreshButton" />

        <ImageButton
            android:id="@+id/quickSettingsTrophiesRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_settings_trophies_refresh"
            android:src="@drawable/ic_refresh"
            android:tint="?attr/pyluxAccent"
            app:layout_constraintTop_toTopOf="@id/quickSettingsTrophiesLabel"
            app:layout_constraintBottom_toBottomOf="@id/quickSettingsTrophiesLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Completion summary — mirrors TrophiesActivity's own header styling (same
             TrophyHeaderCount badges). Only shown alongside a successfully loaded list, so it
             collapses to zero height (GONE) during loading/empty/error states, leaving
             quickSettingsTrophiesProgressBar/EmptyText correctly positioned right below the
             label in those states. -->
        <TextView
            android:id="@+id/quickSettingsTrophiesProgressText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophiesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/quickSettingsTrophiesCountsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="16dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophiesProgressText"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/quickSettingsTrophiesPlatinumCount"
                style="@style/TrophyHeaderCount"
                android:background="@drawable/bg_trophy_platinum" />

            <TextView
                android:id="@+id/quickSettingsTrophiesGoldCount"
                style="@style/TrophyHeaderCount"
                android:background="@drawable/bg_trophy_gold" />

            <TextView
                android:id="@+id/quickSettingsTrophiesSilverCount"
                style="@style/TrophyHeaderCount"
                android:background="@drawable/bg_trophy_silver" />

            <TextView
                android:id="@+id/quickSettingsTrophiesBronzeCount"
                style="@style/TrophyHeaderCount"
                android:background="@drawable/bg_trophy_bronze" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/quickSettingsTrophiesProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophiesLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/quickSettingsTrophiesEmptyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/quick_settings_trophies_empty"
            android:textColor="#B3B3B3"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophiesLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quickSettingsTrophiesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophiesCountsRow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Friends tab: account-level PSN friends list + inline 1:1 messaging, available for every
         session type (not gated like Trophies) since it isn't tied to the game being streamed.
         Two sub-views, only one visible at a time — selecting a friend swaps the list for a chat
         view in place, rather than launching a separate Activity (which would background
         StreamActivity mid-session, same reasoning documented on QuickSettingsPanel). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quickSettingsFriendsSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/quickSettingsHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickSettingsTabDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Sub-view 1: friends list -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quickSettingsFriendsListGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/quickSettingsFriendsLabel"
                style="@style/QuickSettingsSectionLabel"
                android:layout_width="0dp"
                android:text="@string/quick_settings_friends_header_label"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/quickSettingsFriendsRefreshButton" />

            <ImageButton
                android:id="@+id/quickSettingsFriendsRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_settings_friends_refresh"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/pyluxAccent"
                app:layout_constraintTop_toTopOf="@id/quickSettingsFriendsLabel"
                app:layout_constraintBottom_toBottomOf="@id/quickSettingsFriendsLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/quickSettingsFriendsProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendsLabel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/quickSettingsFriendsEmptyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:gravity="center"
                android:text="@string/quick_settings_friends_empty"
                android:textColor="#B3B3B3"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendsLabel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quickSettingsFriendsRecyclerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendsLabel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sub-view 2: inline chat with the selected friend -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quickSettingsFriendsChatGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/quickSettingsFriendChatBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_settings_friend_chat_back"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/pyluxAccent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/quickSettingsFriendChatRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_settings_friend_chat_refresh"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/pyluxAccent"
                app:layout_constraintTop_toTopOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintBottom_toBottomOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintStart_toEndOf="@id/quickSettingsFriendChatBackButton" />

            <TextView
                android:id="@+id/quickSettingsFriendChatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/pyluxAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toTopOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintBottom_toBottomOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintStart_toEndOf="@id/quickSettingsFriendChatRefreshButton"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/quickSettingsFriendChatProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintBottom_toTopOf="@id/quickSettingsFriendChatInputRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/quickSettingsFriendChatEmptyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:gravity="center"
                android:text="@string/friend_chat_empty_state"
                android:textColor="#B3B3B3"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintBottom_toTopOf="@id/quickSettingsFriendChatInputRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quickSettingsFriendChatRecyclerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsFriendChatBackButton"
                app:layout_constraintBottom_toTopOf="@id/quickSettingsFriendChatInputRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/quickSettingsFriendChatInputRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/quickSettingsFriendChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/friend_chat_input_hint"
                    android:inputType="textShortMessage|textCapSentences"
                    android:maxLines="3"
                    android:textColor="@android:color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/quickSettingsFriendChatSendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/friend_chat_send"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    android:tint="?attr/pyluxAccent" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sub-view 3: inline trophy comparison with the selected friend — same "no separate
             Activity" reasoning as the chat sub-view above. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quickSettingsTrophyCompareGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/quickSettingsTrophyCompareBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_settings_trophy_compare_back"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/pyluxAccent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/quickSettingsTrophyCompareRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/trophy_compare_refresh"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/pyluxAccent"
                app:layout_constraintTop_toTopOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintBottom_toBottomOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintStart_toEndOf="@id/quickSettingsTrophyCompareBackButton" />

            <TextView
                android:id="@+id/quickSettingsTrophyCompareTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/pyluxAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toTopOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintBottom_toBottomOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintStart_toEndOf="@id/quickSettingsTrophyCompareRefreshButton"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/quickSettingsTrophyCompareProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/quickSettingsTrophyCompareEmptyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:gravity="center"
                android:text="@string/trophy_compare_empty"
                android:textColor="#B3B3B3"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- A wrap_content RecyclerView inside a ScrollView doesn't reliably remeasure once
                 its adapter data arrives after the initial (empty) layout pass — fixed header
                 above a 0dp-constrained, independently-scrolling RecyclerView below, same pattern
                 the rest of this app's lists already use. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quickSettingsTrophyCompareContentGroup"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareBackButton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <include
                    layout="@layout/item_trophy_compare_header"
                    android:id="@+id/quickSettingsTrophyCompareHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/quickSettingsTrophyCompareDivider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareHeader"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/quickSettingsTrophyCompareSharedGamesLabel"
                    style="@style/QuickSettingsSectionLabel"
                    android:layout_width="0dp"
                    app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareDivider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quickSettingsTrophyCompareRecyclerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/quickSettingsTrophyCompareSharedGamesLabel"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
