<?xml version="1.0" encoding="utf-8"?>
<!-- No background here — the theme-coloured border is applied to the dialog window itself
     (see MainActivity.showDisclaimerDialog) so it wraps the button row too, not just this content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/disclaimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Disclaimer"
        android:textColor="?attr/pyluxAccent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/disclaimerMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CloudPad is still a work in progress. You are responsible for:\n\n• Ensuring you have an active PS Plus Subscription.\n• PS Now and PS5 Cloud Gaming is available in your region.\n• PS5 Games that you purchase or already own are eligible for Cloud Streaming.\n\nIf you are unsure, please either visit the official PSN Store online or use the official PS App to check whether a title is available in your region for streaming."
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</LinearLayout>
