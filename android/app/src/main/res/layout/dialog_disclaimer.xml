<?xml version="1.0" encoding="utf-8"?>
<!-- No background here — the theme-coloured border is applied to the dialog window itself
     (see MainActivity.showDisclaimerDialog) so it wraps the button row too, not just this content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/disclaimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/disclaimer_title"
        android:textColor="?attr/pyluxAccent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/disclaimerMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disclaimer_message"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</LinearLayout>
