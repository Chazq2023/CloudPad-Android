<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- My column: avatar+level, then my own 4 badges as a 2x2 grid underneath. Landscape-compact
         — side by side with the mirrored "their" column below, rather than stacking everything
         (avatars, then every badge) in one tall vertical run. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/trophyCompareMyAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trophyCompareMyLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/pyluxAccent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/trophyCompareMyTotalTrophies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3B3B3"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:autoSizeStepGranularity="1sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/trophyCompareMyPlatinumChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_platinum" />
            <TextView android:id="@+id/trophyCompareMyGoldChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_gold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/trophyCompareMySilverChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_silver" />
            <TextView android:id="@+id/trophyCompareMyBronzeChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_bronze" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="@string/trophy_compare_vs"
        android:textColor="#7A7A7E"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Their column — mirror of the one above. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/trophyCompareTheirAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trophyCompareTheirLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/trophyCompareTheirTotalTrophies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3B3B3"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:autoSizeStepGranularity="1sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/trophyCompareTheirPlatinumChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_platinum" />
            <TextView android:id="@+id/trophyCompareTheirGoldChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_gold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/trophyCompareTheirSilverChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_silver" />
            <TextView android:id="@+id/trophyCompareTheirBronzeChip" style="@style/TrophyCompareBadgeChip" android:background="@drawable/bg_trophy_bronze" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
